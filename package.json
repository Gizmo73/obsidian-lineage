{
  "name": "obsidian-lineage",
  "version": "0.1.0",
  "description": "Data-driven family trees for Obsidian, built from Mother, Father and Spouse frontmatter.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node scripts/run-tests.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "family tree",
    "genealogy"
  ],
  "author": "gizmo73",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "tslib": "^2.8.0",
    "typescript": "^5.6.0",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "svg2pdf.js": "^2.8.1"
  }
}
